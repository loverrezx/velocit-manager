{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velocit Manager",
  "version": "0.1.5",
  "identifier": "com.accountmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Velocit Manager",
        "width": 1190,
        "height": 640,
        "resizable": false,
        "maximizable": false,
        "minWidth": 1190,
        "minHeight": 640,
        "maxWidth": 1190,
        "maxHeight": 640,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Velocit Manager",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwMkY4NzJGODJEMDk3RkMKUldUOGw5Q0NMNGN2Z0x2R1lmTFZZQllEOXoxSzI1dkxmSlZNTHp5ZjlpanhPUGhhT1pUeDJHVEoK",
      "endpoints": [
        "https://github.com/loverrezx/velocit-manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
